                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Leia koostisetingimustele vastavaid tooteid ja võrdle nende toitainesisaldust.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
