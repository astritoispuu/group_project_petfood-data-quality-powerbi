table dim_products
	lineageTag: 8a0a55dd-1183-4f5a-a527-058f3c926e0b

	measure Valiku_labinud_toodete_arv =
			
			COALESCE (
			    COUNTROWS (
			        FILTER (
			            // Võtame iga toote ID ühe korra.
			            VALUES ( 'dim_products'[product_id] ),
			
			            // Jätame tühja ID välja ja kontrollime iga toote filtrit.
			            NOT ISBLANK ( 'dim_products'[product_id] )
			                && CALCULATE ( [Toote_Koostisosa_Filter] ) = 1
			        )
			    ),
			
			    // Kui ükski toode valikut ei läbi, kuvame nulli.
			    0
			)
		formatString: 0
		lineageTag: b2455bb5-556b-48e6-8ecf-4fb22e1c6e97

	measure Valistatud_toodete_arv =
			
			VAR TootedEnneValistamist =
			    // Loendame erinevad toote ID-d; tühjad ID-d jätame välja.
			    COALESCE (
			        DISTINCTCOUNTNOBLANK ( 'dim_products'[product_id] ),
			        0
			    )
			RETURN
			    // Lahutame algarvust valiku läbinud toodete arvu.
			    TootedEnneValistamist - [Valiku_labinud_toodete_arv]
		formatString: 0
		lineageTag: 9edb6ada-7f4a-4a5e-8a10-b058e06ed238

